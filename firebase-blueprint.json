{
  "entities": {
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Authoritative registry of system administrator UIDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private banking client profile containing PII and account status flags.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "accountNumber": { "type": "string", "minLength": 8, "maxLength": 20, "pattern": "^[0-9]{8,20}$" },
        "routingNumber": { "type": "string", "minLength": 9, "maxLength": 9, "pattern": "^[0-9]{9}$" },
        "pinCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "isVerified": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "isFrozen": { "type": "boolean" },
        "isSuspended": { "type": "boolean" },
        "biometricsEnabled": { "type": "boolean" },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP"] },
        "accountType": { "type": "string", "enum": ["personal", "business", "private_wealth"] },
        "businessName": { "type": "string", "maxLength": 100 },
        "primaryFocus": { "type": "string", "enum": ["savings_yield", "spending_cards", "wires_transfers", "lending_investing"] },
        "monthlyVolume": { "type": "string", "enum": ["under_5k", "5k_25k", "25k_100k", "over_100k"] },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "firstName", "lastName", "email", "accountNumber", "routingNumber",
        "isVerified", "isAdmin", "isFrozen", "isSuspended", "biometricsEnabled",
        "currency", "createdAt", "updatedAt"
      ]
    },
    "UserBalance": {
      "title": "UserBalance",
      "description": "Checking and savings financial balances for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "checking": { "type": "number" },
        "savings": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "checking", "savings", "updatedAt"]
    },
    "BankTransaction": {
      "title": "BankTransaction",
      "description": "Immutable financial transaction ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "transfer_sent", "transfer_received", "card_spend"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "merchant": { "type": "string", "minLength": 1, "maxLength": 160 },
        "recipientEmail": { "type": "string", "maxLength": 254 },
        "senderEmail": { "type": "string", "maxLength": 254 },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "type", "category", "merchant", "status", "createdAt"]
    },
    "VirtualCard": {
      "title": "VirtualCard",
      "description": "Issued virtual or physical payment card record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "cardholderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cardNumber": { "type": "string", "minLength": 16, "maxLength": 24 },
        "expiryDate": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$" },
        "cvv": { "type": "string", "minLength": 3, "maxLength": 4, "pattern": "^[0-9]{3,4}$" },
        "isFrozen": { "type": "boolean" },
        "spendingLimit": { "type": "number" },
        "spentThisMonth": { "type": "number" },
        "cardType": { "type": "string", "enum": ["platinum", "ebony", "emerald", "physical"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "cardholderName", "cardNumber", "expiryDate", "cvv",
        "isFrozen", "spendingLimit", "spentThisMonth", "cardType", "createdAt", "updatedAt"
      ]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Client savings goal reserve and auto-save configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "autoSaveEnabled": { "type": "boolean" },
        "autoSavePercentage": { "type": "number" },
        "color": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "title", "targetAmount", "currentAmount",
        "autoSaveEnabled", "autoSavePercentage", "color", "createdAt", "updatedAt"
      ]
    },
    "BankNotification": {
      "title": "BankNotification",
      "description": "Account activity and system alert notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "isRead": { "type": "boolean" },
        "type": { "type": "string", "enum": ["info", "alert", "success", "system"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "isRead", "type", "createdAt"]
    },
    "UserSecuritySettings": {
      "title": "UserSecuritySettings",
      "description": "Client security, notification, and interface theme preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "faceIdEnabled": { "type": "boolean" },
        "webAuthnConfigured": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "emailStatements": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "faceIdEnabled", "webAuthnConfigured", "pushNotifications",
        "emailStatements", "twoFactorEnabled", "theme", "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiries and verification document packets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "documentBase64": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "description", "status", "category", "createdAt", "updatedAt"]
    },
    "Beneficiary": {
      "title": "Beneficiary",
      "description": "Saved wire transfer recipient contacts for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "email", "createdAt"]
    },
    "LoanApplication": {
      "title": "LoanApplication",
      "description": "Client loan and mortgage applications reviewed by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "loanType": { "type": "string", "enum": ["personal", "auto", "mortgage", "business"] },
        "amount": { "type": "number" },
        "termMonths": { "type": "number" },
        "apr": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "annualIncome": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "loanType", "amount", "termMonths", "apr",
        "monthlyPayment", "purpose", "annualIncome", "status", "createdAt", "updatedAt"
      ]
    },
    "InvestmentPosition": {
      "title": "InvestmentPosition",
      "description": "Client investment holdings and portfolio allocations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["index_etf", "treasury", "growth_tech", "dividend"] },
        "investedAmount": { "type": "number" },
        "expectedYield": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "redemption_requested", "redeemed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "symbol", "name", "category", "investedAmount",
        "expectedYield", "status", "createdAt", "updatedAt"
      ]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Immutable audit log of administrative actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "targetUserId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "details": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminId", "adminEmail", "action", "targetUserId", "details", "timestamp"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time bidirectional management chat message between a client and administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderRole": { "type": "string", "enum": ["client", "admin"] },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "isReadByAdmin": { "type": "boolean" },
        "isReadByClient": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "senderUid", "senderRole", "senderName",
        "text", "isReadByAdmin", "isReadByClient", "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted administrator UIDs registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private banking user profiles (PII restricted to owner or admin)."
    },
    "/balances/{userId}": {
      "schema": { "$ref": "#/entities/UserBalance" },
      "description": "User checking and savings balances."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/BankTransaction" },
      "description": "Immutable financial transaction ledger."
    },
    "/cards/{cardId}": {
      "schema": { "$ref": "#/entities/VirtualCard" },
      "description": "Virtual and physical payment cards owned by users."
    },
    "/savings_goals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "User savings goals and auto-save rules."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/BankNotification" },
      "description": "Per-user system and transactional notifications."
    },
    "/settings/{userId}": {
      "schema": { "$ref": "#/entities/UserSecuritySettings" },
      "description": "Per-user security toggles and UI theme preferences."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets and verification document packets."
    },
    "/beneficiaries/{beneficiaryId}": {
      "schema": { "$ref": "#/entities/Beneficiary" },
      "description": "Saved wire transfer beneficiaries."
    },
    "/loan_applications/{loanId}": {
      "schema": { "$ref": "#/entities/LoanApplication" },
      "description": "Client loan and mortgage applications."
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/InvestmentPosition" },
      "description": "Client investment holdings and ETF positions."
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Immutable security audit trail for admin operations."
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time bidirectional client-to-management chat threads."
    }
  }
}
